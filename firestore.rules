rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isSuperAdmin() {
      return request.auth != null
        && (
          request.auth.token.super_admin == true
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
          )
        );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ---- Hostels ----
    // Public catalog: students must see hostels before signing in.
    match /hostels/{hostelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Rooms ----
    // Public catalog: availability/room info shown to all guests.
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Beds ----
    // Public catalog: bed availability shown to all guests.
    // Students may only flip an available bed to 'pending' when booking;
    // all other writes are admin-only.
    match /beds/{bedId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated() && request.resource.data.status in ['available', 'pending']);
      allow delete: if isAdmin();
    }

    // ---- Students ----
    // Writes happen via trusted Cloud Functions (Admin SDK bypasses rules).
    // Fallback: any signed-in user can create their own record; admins manage them.
    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Bookings ----
    // Public users can look up only with a valid booking reference.
    // Fallback: signed-in users can create pending bookings; admins manage them.
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.bookingReference != null);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Payments ----
    // Fallback: signed-in users create the payment record; admins confirm it.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Semesters ----
    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Accommodation Types ----
    match /accommodationTypes/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Admins ----
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isSuperAdmin();
    }

    // ---- Settings ----
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ---- Audit Logs ----
    // Written by Cloud Functions only; readable by admins.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}